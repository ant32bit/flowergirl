{
  "name": "flowergirl",
  "version": "1.0.0",
  "description": "A 2D game where a girl collects flowers and birds fly around",
  "scripts": {
    "build": "tsc && webpack && python3 integrate.py",
    "start": "npm run build && python3 -m http.server --directory dist/www-root 4600",
    "dev": "npm start",
    "test": "mocha dist/transpiled/test/**/*.js",
    "test:watch": "mocha dist/transpiled/test/**/*.js --watch",
    "build:test": "tsc && npm test"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "chai": "^4.3.0",
    "mocha": "^10.0.0",
    "typescript": "^5.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^6.0.1"
  }
}
